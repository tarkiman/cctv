# Copy to .env next to docker-compose.yml.

# Creates the first admin on first start (ignored once a user exists).
NVR_ADMIN_USER=admin
NVR_ADMIN_PASSWORD=ganti-dengan-password-panjang

NVR_LISTEN=:8090
NVR_GO2RTC_URL=http://127.0.0.1:1984
NVR_GO2RTC_RTSP=rtsp://127.0.0.1:8556
NVR_TZ=Asia/Jakarta
NVR_SEGMENT_SECONDS=600
NVR_SNAPSHOT_SECONDS=60
NVR_LOG_LEVEL=info
# Cookies are marked Secure automatically over HTTPS (incl. Cloudflare tunnel);
# set true to force it.
NVR_SECURE_COOKIE=false
# Origins allowed for live view through a proxy that rewrites Host (comma-separated)
NVR_ALLOWED_ORIGINS=cctv.tarkiman.com

# Alerts: camera down > NVR_NOTIFY_OFFLINE_MINUTES (incl. expired Xiaomi session),
# disk far below the retention floor, and a message on every start. Comma-separated:
#   Discord:  https://discord.com/api/webhooks/<id>/<token>
#   WhatsApp (gowa): http://user:pass@<host>:3000/send/message?phone=62812xxxx
#   other:    any URL; receives {"kind","level","title","text","camera","url","at"}
NVR_NOTIFY_WEBHOOK=
NVR_NOTIFY_OFFLINE_MINUTES=5
# Base URL for links in notifications
NVR_PUBLIC_URL=https://cctv.tarkiman.com

# Host data folder and image tag (used by docker-compose.yml itself)
NVR_DATA=/DATA/nvr
NVR_TAG=nvr-lite
