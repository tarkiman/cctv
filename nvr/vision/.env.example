# nvr-vision on the analysis machine. Copy to .env next to docker-compose.yml (chmod 600).
VISION_TOKEN=same-as-NVR_VISION_TOKEN-on-the-NVR-host
# go2rtc on the NVR host, with the rtsp login from its go2rtc.yaml.
VISION_RTSP=rtsp://vision:PASSWORD@192.168.1.20:8556
VISION_CALLBACK=http://192.168.1.20:8091/api/v1/vision/report
# Optional: VISION_THREADS=2  VISION_FPS=3  VISION_PERSON_MIN=0.45  VISION_FACE_MIN=0.6
