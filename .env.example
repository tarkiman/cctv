# Salin file ini ke .env lalu isi sesuai kamera di rumah:
#   cp .env.example .env
#
# Variabel host kamera HARUS diawali FRIGATE_ agar terbaca oleh frigate/config.template.yml.
# cam2..cam5 ada di komentar di frigate/config.template.yml sebagai template kamera
# non-prioritas (tanpa AI) -- uncomment blok yang sesuai di sana dulu, baru isi host-nya
# di sini. Lihat CAMERAS.md untuk detail akses & jenis tiap kamera yang sudah terdaftar.

FRIGATE_CAM1_HOST=192.168.1.101
# FRIGATE_CAM2_HOST=192.168.1.102
# FRIGATE_CAM3_HOST=192.168.1.103
# FRIGATE_CAM4_HOST=192.168.1.104
# FRIGATE_CAM5_HOST=192.168.1.105

# Kamera bergaya ONVIF (mis. "bardi") butuh user/password RTSP terpisah, bukan cuma
# host -- lihat CAMERAS.md untuk cara dapatkan path RTSP resminya lewat ONVIF
# GetStreamUri (path/port bisa beda-beda per kamera, bukan /unicast:8554).
FRIGATE_BARDI_HOST=192.168.1.27
FRIGATE_BARDI_USER=admin
FRIGATE_BARDI_PASS=changeme

# Kamera Xiaomi Mi Home stock (tanpa custom firmware/ONVIF, mis. "c301") TIDAK dikonfig
# di sini -- kredensialnya (akun Mi Home cloud) ada di storage/go2rtc/go2rtc.yaml
# lewat service go2rtc standalone. Lihat go2rtc/go2rtc.yaml.example dan CAMERAS.md.

# Kamera mana yang AI object detection-nya aktif (dipisah koma, tanpa spasi) --
# hanya kamera yang di frigate/config.template.yml sudah punya token
# `enabled: __DETECT_<NAMA>__` yang bisa dikontrol lewat sini (lihat cam1 & bardi).
# Ganti baris ini lalu `docker compose up -d --force-recreate frigate` -- tidak perlu
# edit YAML manual. Nilai ini cuma dipakai kalau belum pernah di-set lewat panel
# (storage/panel/detect_cameras.txt kosong/belum ada) -- begitu pernah diubah lewat
# panel, file itu yang jadi sumber kebenaran, bukan baris ini lagi.
DETECT_CAMERAS=bardi

# Login panel kontrol web (http://<ip-pi>:8090) -- tempat toggle AI detection per
# kamera dari browser tanpa perlu SSH. LAN saja, wajib isi PANEL_PASS (panel menolak
# start kalau kosong).
PANEL_USER=admin
PANEL_PASS=changeme

# Nama kamera (HARUS SAMA PERSIS dengan key kamera di frigate/config.template.yml), dipisah koma.
# Dipakai oleh service timelapse untuk tahu kamera mana yang harus di-snapshot lewat
# Frigate API (/api/<nama>/latest.jpg). Tambahkan nama kamera baru di sini setiap kali
# uncomment kamera baru di frigate/config.template.yml.
TIMELAPSE_CAMERAS=cam1,bardi,c301

# Interval snapshot timelapse (detik).
TIMELAPSE_INTERVAL_SECONDS=60
# Framerate video timelapse hasil compile harian.
TIMELAPSE_FRAMERATE=24
# Kalau "true", JPEG mentah tidak dihapus setelah compile harian (butuh lebih banyak storage).
TIMELAPSE_KEEP_RAW=false
